ALLDEBRID_API_KEY=replace_with_a_rotated_server_side_key
PROWLARR_URL=https://your-prowlarr.example.com
PROWLARR_API_KEY=replace_with_a_server_side_prowlarr_key
TMDB_READ_ACCESS_TOKEN=replace_with_a_tmdb_read_access_token

# Optional production overrides (the defaults work for a single Railway service).
# KHEYFLIX_TRANSCODER_URL=http://127.0.0.1:3101
# KHEYFLIX_TRANSCODER_PORT=3101
# KHEYFLIX_APP_ORIGIN=http://127.0.0.1:3000
# Safe default: relay provider traffic through one controlled service identity.
KHEYFLIX_STREAM_MODE=relay
# Refresh a temporary provider link once if no initial media byte arrives in
# this bounded window (250-8000ms). Keep it below the player startup budget.
KHEYFLIX_STREAM_FIRST_BYTE_TIMEOUT_MS=3000
# Bootstrap plus standard HLS need two slots; raise only after provider review.
KHEYFLIX_MAX_JOBS=2
# Bound native-HLS playlist startup so a failed encoder cannot occupy capacity.
KHEYFLIX_HLS_STARTUP_TIMEOUT_MS=30000
# Required together in production to protect provider-backed browser routes,
# sign opaque browser sessions, and allow the local transcoder to read the
# protected internal stream route.
KHEYFLIX_ACCESS_TOKEN=replace_with_a_long_random_access_code
KHEYFLIX_SESSION_SECRET=replace_with_a_distinct_long_random_session_secret
KHEYFLIX_INTERNAL_TRANSCODER_TOKEN=replace_with_a_distinct_long_random_internal_token
