#!/bin/sh
set -eu

remote_name=${1:-}
remote_url=${2:-}
if [ "$remote_url" != 'git@github.com:GDemay/Kheyflix.git' ]; then
  echo "Kheyflix push blocked: '$remote_name' is not GDemay/Kheyflix ($remote_url)." >&2
  exit 1
fi

ssh_identity=$(ssh -i /Users/gdemay/.ssh/kheyflix_orchestrator -o IdentitiesOnly=yes -T git@github.com 2>&1 || true)
if ! printf '%s\n' "$ssh_identity" | grep -Fq "Hi GDemay/Kheyflix!"; then
  echo "Kheyflix push blocked: the repository deploy key did not authenticate for GDemay/Kheyflix." >&2
  exit 1
fi

echo "Kheyflix push authorized: GDemay -> GDemay/Kheyflix." >&2
